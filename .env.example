METROTRANCE_HOST=127.0.0.1
METROTRANCE_PORT=8765
METROTRANCE_OPEN_BROWSER=true
METROTRANCE_DATA_DIR=./data

# Built-in local writer. Ollama is not required.
SCRIPT_PROVIDER=llama_cpp
LOCAL_LLAMA_URL=http://127.0.0.1:8080/v1
LOCAL_LLAMA_BINARY=
LOCAL_LLAMA_MODEL=
LOCAL_LLAMA_MODEL_NAME=Qwen3 local
LOCAL_LLAMA_CONTEXT=8192
LOCAL_LLAMA_THREADS=4
LOCAL_LLAMA_STARTUP_TIMEOUT=300

# Speech synthesis: auto, qwen, chatterbox
TTS_PROVIDER=auto
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN_TTS_DEVICE=auto
CHATTERBOX_DEVICE=auto

# Audio defaults
AMBIENT_VOLUME=0.11
PAUSE_SECONDS=1.15

# Studio pacing is selected in the interface. Speech time-stretch is disabled.
# The 0.6B model remains the lightweight default for the current old laptop.
